---
import { getCollection } from 'astro:content';
import Bazowy from '../../layouts/Bazowy.astro';
import { WYMIARY, ZASADY_MODERACJI } from '../../lib/glosy';

export async function getStaticPaths() {
  const parafie = await getCollection('parafie');
  return parafie.map((parafia) => ({
    params: { slug: parafia.data.slug },
    props: { parafia },
  }));
}

const { parafia } = Astro.props;
const { data } = parafia;
const zapisUrl = import.meta.env.PUBLIC_ZAPIS_URL ?? 'http://localhost:8788';
---

<Bazowy
  tytul={`Twój głos o: ${data.nazwa} — ${data.miasto}`}
  opis={`Podziel się doświadczeniem z parafii ${data.nazwa} (${data.miasto}): ocena w pięciu wymiarach i słowo od Ciebie, po moderacji.`}
>
  <div class="kicker wrap">Twój głos</div>
  <section class="wrap">
    <div class="sheet">
      <div class="denom">Parafia {data.wyznanie} · {data.miasto}</div>
      <h2>{data.nazwa}</h2>
      <p class="wstep">
        Napisz od razu — adres potwierdzisz jednym kliknięciem po wysłaniu.
        Podpisujemy głos wyłącznie pseudonimem.
      </p>

      <form class="form-glos" method="post" action={`${zapisUrl}/glos`}>
        <input type="hidden" name="parafia" value={data.slug} />

        <fieldset class="oceny">
          <legend>Jak Ci tam było?</legend>
          {
            [['ocenaOgolna', 'Ogólnie'] as const, ...Object.entries(WYMIARY)].map(
              ([nazwa, etykieta]) => (
                <div class="ocena">
                  <span class="ocena-nazwa">{etykieta}</span>
                  <span class="ocena-skala">
                    {[1, 2, 3, 4, 5].map((n) => (
                      <label class="gwiazdka">
                        <input type="radio" name={nazwa} value={String(n)} required />
                        <span>{n}</span>
                      </label>
                    ))}
                  </span>
                </div>
              ),
            )
          }
        </fieldset>

        <label>
          Twoje doświadczenie (opcjonalnie)
          <textarea name="tekst" rows="4" maxlength="2000"></textarea>
        </label>
        <label>
          Pseudonim (podpis Twojego głosu)
          <input type="text" name="pseudonim" required maxlength="80" />
        </label>
        <label>
          Adres e-mail (tylko do potwierdzenia, nigdy publiczny)
          <input type="email" name="email" required autocomplete="email" />
        </label>
        <button type="submit">Wyślij głos</button>
        <p class="dopisek">
          Po wysłaniu dostaniesz jeden link — kliknięcie potwierdza, że to Ty.
          Bez niego głos nie zostanie opublikowany.
        </p>
      </form>

      <div class="mod">{ZASADY_MODERACJI}</div>
    </div>
  </section>
</Bazowy>
