---
import { getCollection } from 'astro:content';
import Bazowy from '../layouts/Bazowy.astro';

const parafie = (await getCollection('parafie')).sort((a, b) =>
  a.data.nazwa.localeCompare(b.data.nazwa, 'pl'),
);

// Start jest bramą, nie spisem: przy 26 parafiach Gdańska jedna długa
// strona spychała Toruń o kilkanaście ekranów w dół (docs/13, analiza).
type Karta = {
  slug: string;
  nazwa: string;
  ile: number;
  wizytowki: { plik: string; alt: string }[];
};
const miasta: Karta[] = [...new Map(parafie.map((p) => [p.data.miastoSlug, p.data.miasto]))]
  .sort(([, a], [, b]) => a.localeCompare(b, 'pl'))
  .map(([slug, nazwa]) => {
    const wMiescie = parafie.filter((p) => p.data.miastoSlug === slug);
    return {
      slug,
      nazwa,
      ile: wMiescie.length,
      wizytowki: wMiescie
        .flatMap((p) => (p.data.zdjecie ? [{ plik: p.data.zdjecie.plik, alt: '' }] : []))
        .slice(0, 3),
    };
  });

const odmianaParafii = (n: number): string => {
  if (n === 1) return 'parafia';
  if (n % 10 >= 2 && n % 10 <= 4 && (n % 100 < 12 || n % 100 > 14)) return 'parafie';
  return 'parafii';
};
---

<Bazowy
  tytul="Church — znajdź swoje miejsce"
  opis={`Parafie w miastach: ${miasta.map((m) => m.nazwa).join(', ')}. Godziny mszy, spowiedź, msze z dziećmi — same fakty, każdy ze źródłem i datą odczytu.`}
>
  <section class="hero wrap">
    <h1>Gdzie szukasz<br />swojego miejsca?</h1>
    <p class="sub">Godziny mszy, spowiedź, msze z dziećmi — same fakty, każdy ze źródłem.</p>
  </section>

  <section class="wrap bramy" aria-label="Wybór miasta">
    {
      miasta.map((m) => (
        <a class="brama" href={`/${m.slug}`} id={`miasto-${m.slug}`}>
          <span class="brama-tresc">
            <b class="brama-nazwa">{m.nazwa}</b>
            <span class="brama-ile">
              {m.ile} {odmianaParafii(m.ile)}
            </span>
          </span>
          {m.wizytowki.length > 0 && (
            <span class="brama-zdjecia">
              {m.wizytowki.map((w) => (
                <img src={`/wizytowki/${w.plik}`} alt="" loading="lazy" />
              ))}
            </span>
          )}
        </a>
      ))
    }
  </section>
</Bazowy>
