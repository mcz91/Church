---
import { getCollection } from 'astro:content';
import Bazowy from '../../../layouts/Bazowy.astro';
import Kropki from '../../../components/Kropki.astro';
import { glosyParafii, policzAgregaty } from '../../../lib/agregaty';
import { WYMIARY, liczbaZPrzecinkiem, miesiacGlosu, odmianaGlosow } from '../../../lib/glosy';
import type { Wymiar } from '../../../lib/glosy';
import { OSIE } from '../../../lib/parafie';
import type { Os } from '../../../lib/parafie';
import { sciezkaPorownania } from '../../../lib/porownanie';

export async function getStaticPaths() {
  const parafie = await getCollection('parafie');
  return parafie.map((parafia) => ({
    params: { miasto: parafia.data.miastoSlug, slug: parafia.data.slug },
    props: {
      parafia,
      pozostale: parafie
        .filter(
          (p) => p.data.slug !== parafia.data.slug && p.data.miastoSlug === parafia.data.miastoSlug,
        )
        .sort((a, b) => a.data.nazwa.localeCompare(b.data.nazwa, 'pl')),
    },
  }));
}

const { parafia, pozostale } = Astro.props;
const { data } = parafia;
const osieZDanymi = (Object.keys(OSIE) as Os[]).filter((os) => data.osie[os]);
const mapyUrl = `https://www.openstreetmap.org/search?query=${encodeURIComponent(`${data.adres.wartosc}`)}`;

const zapisUrl = import.meta.env.PUBLIC_ZAPIS_URL ?? 'http://localhost:8788';
const wybor = glosyParafii(data.slug, (await getCollection('glosy')).map((g) => g.data));
const agregaty = policzAgregaty(wybor);
const glosy = [...wybor.glosy].sort((a, b) => b.data.localeCompare(a.data));

// Zdjęcia opublikowanych głosów: pliki żyją w repo obok plików głosów;
// druga ścieżka globa istnieje wyłącznie dla builda testowego na danych
// fikcyjnych (katalog znika po teście).
const zasobyZdjec = {
  ...import.meta.glob('/src/dane/glosy/**/*.{jpg,jpeg,png}', {
    eager: true,
    query: '?url',
    import: 'default',
  }),
  ...import.meta.glob('/tests/fixtures/glosy-build/**/*.{jpg,jpeg,png}', {
    eager: true,
    query: '?url',
    import: 'default',
  }),
} as Record<string, string>;
const urlZdjecia = (plik: string): string | null =>
  Object.entries(zasobyZdjec).find(([sciezka]) => sciezka.endsWith(`/${data.slug}/${plik}`))?.[1] ??
  null;
const zdjeciaProfilu = glosy.flatMap((glos) =>
  (glos.zdjecia ?? []).flatMap((zdjecie) => {
    const url = urlZdjecia(zdjecie.plik);
    return url ? [{ ...zdjecie, url, autor: glos.autor.pseudonim }] : [];
  }),
);
---

<Bazowy
  tytul={`${data.nazwa} — ${data.miasto}`}
  opis={`Fakty o parafii: ${data.nazwa}, ${data.miasto}. ${osieZDanymi.map((os) => OSIE[os]).join(', ')} — każdy fakt ze źródłem i datą odczytu.`}
  obraz={data.zdjecie ? `/wizytowki/${data.zdjecie.plik}` : undefined}
>
  <div class="kicker wrap">Profil</div>
  <section class="wrap">
    <div class="sheet">
      {
        data.zdjecie && (
          <figure class="wizytowka">
            <img src={`/wizytowki/${data.zdjecie.plik}`} alt={data.zdjecie.alt} />
            <figcaption>
              fot. {data.zdjecie.autor} · {data.zdjecie.licencja} ·{' '}
              <a href={data.zdjecie.zrodloUrl}>Wikimedia Commons</a>
            </figcaption>
          </figure>
        )
      }
      <div class="profile-top">
        <div>
          <div class="denom">Parafia {data.wyznanie} · {data.miasto}</div>
          <h2>{data.nazwa}</h2>
          <div class="addr">
            {data.adres.wartosc}
            <span class="src"
              >wg <a href={data.adres.zrodlo.url}>{data.adres.zrodlo.nazwa}</a>, {data.adres.dataOdczytu}</span
            >
            · <a href={mapyUrl}>otwórz w mapach ↗</a>
            {data.www && <> · <a href={data.www}>strona parafii ↗</a></>}
          </div>
        </div>
        {
          agregaty && (
            <div class="bigscore">
              <div class="n">
                {liczbaZPrzecinkiem(agregaty.ogolna)}
                <small> / 5</small>
              </div>
              <Kropki ocena={agregaty.ogolna} />
              <div class="c">
                {agregaty.liczba} {odmianaGlosow(agregaty.liczba)}
              </div>
            </div>
          )
        }
      </div>

      <dl class="facts">
        {
          osieZDanymi.map((os) => {
            const fakt = data.osie[os]!;
            return (
              <div>
                <dt>{OSIE[os]}</dt>
                <dd>
                  {fakt.wartosc}
                  <span class="src">
                    wg <a href={fakt.zrodlo.url}>{fakt.zrodlo.nazwa}</a>, {fakt.dataOdczytu}
                  </span>
                </dd>
              </div>
            );
          })
        }
      </dl>
      <p class="zglos">
        Dostrzegasz błąd w faktach? <a href={`${zapisUrl}/blad/${data.miastoSlug}/${data.slug}`}>Zgłoś błąd</a>{' '}
        — poprawka ma pierwszeństwo.
      </p>

      {
        zdjeciaProfilu.length > 0 && (
          <div class="gallery" aria-label="Zdjęcia miejsca z opublikowanych głosów">
            {zdjeciaProfilu.map((zdjecie) => (
              <figure class="ph">
                <img src={zdjecie.url} alt={zdjecie.alt} loading="lazy" />
                <figcaption>
                  {zdjecie.podpis ? `${zdjecie.podpis} · ` : ''}fot. {zdjecie.autor}
                </figcaption>
              </figure>
            ))}
          </div>
        )
      }

      {
        agregaty && (
          <div class="aspects">
            <h4>Z głosów, w pięciu wymiarach doświadczenia</h4>
            <div class="agrid">
              {(Object.keys(WYMIARY) as Wymiar[]).map((wymiar) => (
                <div class="arow">
                  {WYMIARY[wymiar]}
                  <span class="v">
                    <Kropki ocena={agregaty.wymiary[wymiar]} />
                    <span class="score-num">{liczbaZPrzecinkiem(agregaty.wymiary[wymiar])}</span>
                  </span>
                </div>
              ))}
            </div>
          </div>
        )
      }

      <div class="voices">
        {
          agregaty ? (
            <h3>
              Głosy <small>{agregaty.liczba} · po moderacji</small>
            </h3>
          ) : (
            <h3>Głosy</h3>
          )
        }
        {
          glosy.map((glos) => (
            <div class="quote">
              <div class="qhead">
                <div class="by">
                  <b>{glos.autor.pseudonim}</b> · {miesiacGlosu(glos.data)}
                </div>
                <div class="sc">
                  <Kropki ocena={glos.ocenaOgolna} />
                  <span class="score-num">{liczbaZPrzecinkiem(glos.ocenaOgolna)}</span>
                </div>
              </div>
              {glos.tekst && <p>{glos.tekst}</p>}
            </div>
          ))
        }
        {glosy.length === 0 && <p class="pusto">Jeszcze żadnego głosu — Twój może być pierwszy.</p>}
        <div class="mod">
          Każdy głos ma autora, ocenę w pięciu wymiarach doświadczenia i przechodzi moderację
          przed publikacją.
        </div>
        <a class="addvoice" href={`/glos/${data.slug}`}>Dodaj swój głos</a>
      </div>

      {
        pozostale.length > 0 && (
          <div class="porownaj-z">
            <span class="label">Porównaj z…</span>
            <br />
            {pozostale.map((p) => (
              <a href={sciezkaPorownania(data.slug, p.data.slug)}>{p.data.nazwa}</a>
            ))}
          </div>
        )
      }
    </div>
  </section>
</Bazowy>
