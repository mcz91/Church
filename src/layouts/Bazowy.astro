---
interface Props {
  tytul: string;
  opis: string;
}

const { tytul, opis } = Astro.props;
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tytul}</title>
    <meta name="description" content={opis} />
    <meta property="og:title" content={tytul} />
    <meta property="og:description" content={opis} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pl_PL" />
    <meta property="og:site_name" content="Church" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <header class="site">
      <div class="wordmark"><a href="/">Church<i>.</i></a></div>
      <div class="note">fakty ze źródłem i datą odczytu</div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site">
      <div class="line">Fakty ze źródłem, każdy z datą odczytu.</div>
      Dostrzegasz błąd w danych? Popraw go w repozytorium — każda zmiana faktu ma autora i historię.
    </footer>
    <script>
      // Jednorazowe wyłonienia sekcji tylko przy działającym JS —
      // bez niego strona jest w pełni widoczna od razu.
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const elementy = document.querySelectorAll('.hero, .list .row, .kicker, .sheet');
        elementy.forEach((e) => e.classList.add('will'));
        if ('IntersectionObserver' in window) {
          const io = new IntersectionObserver(
            (wpisy) => {
              for (const w of wpisy) {
                if (w.isIntersecting) {
                  w.target.classList.add('in');
                  io.unobserve(w.target);
                }
              }
            },
            { threshold: 0.1, rootMargin: '0px 0px -5% 0px' },
          );
          elementy.forEach((e) => io.observe(e));
        } else {
          elementy.forEach((e) => e.classList.add('in'));
        }
      }
    </script>
  </body>
</html>

<style is:global>
  :root {
    --bg: #fbfaf6;
    --surface: #ffffff;
    --ink: #252a26;
    --muted: #7a8078;
    --accent: #3e6b5e;
    --accent-deep: #33584e;
    --accent-soft: #edf2ef;
    --line: #e8e6dc;
    --line-soft: rgba(122, 128, 120, 0.28);
    --serif: 'Iowan Old Style', 'Palatino Linotype', Palatino, Georgia, serif;
    --sans: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
  }
  * {
    box-sizing: border-box;
    margin: 0;
  }
  body {
    background: var(--bg);
    color: var(--ink);
    font-family: var(--sans);
    line-height: 1.65;
    padding: 0 22px 64px;
    font-size: 15.5px;
    -webkit-font-smoothing: antialiased;
  }
  ::selection {
    background: var(--accent-soft);
    color: var(--accent-deep);
  }
  a {
    color: var(--accent);
  }
  :focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
    border-radius: 2px;
  }
  .wrap {
    max-width: 660px;
    margin: 0 auto;
  }

  .will {
    opacity: 0;
    transform: translateY(12px);
    transition:
      opacity 0.8s ease,
      transform 0.8s cubic-bezier(0.2, 0.6, 0.2, 1);
  }
  .will.in {
    opacity: 1;
    transform: none;
  }
  .list .row.will:nth-child(2) {
    transition-delay: 0.07s;
  }
  .list .row.will:nth-child(3) {
    transition-delay: 0.14s;
  }

  .kicker {
    font-size: 0.68rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--muted);
    margin: 60px 0 16px;
    text-align: center;
  }
  .kicker::after {
    content: '';
    display: block;
    width: 1px;
    height: 30px;
    margin: 14px auto 0;
    background: linear-gradient(var(--line-soft), transparent);
  }

  header.site {
    padding: 66px 0 6px;
    text-align: center;
  }
  .wordmark {
    font-family: var(--serif);
    font-size: 1.5rem;
    letter-spacing: 0.015em;
  }
  .wordmark a {
    color: inherit;
    text-decoration: none;
  }
  .wordmark i {
    color: var(--accent);
    font-style: normal;
  }
  header.site .note {
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
    margin-top: 10px;
  }

  .hero {
    text-align: center;
    padding: 36px 0 6px;
    position: relative;
  }
  .hero::before {
    content: '';
    position: absolute;
    inset: -40px -60px auto;
    height: 300px;
    pointer-events: none;
    background: radial-gradient(340px 190px at 50% 30%, rgba(62, 107, 94, 0.055), transparent 70%);
  }
  .hero h1 {
    font-family: var(--serif);
    font-weight: 400;
    font-size: clamp(2.1rem, 5.6vw, 3rem);
    line-height: 1.18;
    text-wrap: balance;
    letter-spacing: 0.002em;
  }
  .hero .sub {
    font-family: var(--serif);
    font-style: italic;
    color: var(--muted);
    margin-top: 12px;
    font-size: 1.12rem;
    letter-spacing: 0.005em;
  }
  .miasto-pigulka {
    display: inline-block;
    margin-top: 28px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--surface);
    padding: 9px 26px;
    font-size: 0.95rem;
    box-shadow:
      0 1px 2px rgba(37, 42, 38, 0.03),
      0 6px 24px rgba(37, 42, 38, 0.05);
  }
  .miasto-pigulka b {
    font-family: var(--serif);
    font-weight: 500;
  }

  .list {
    margin-top: 28px;
    border-top: 1px solid var(--line);
    text-align: left;
  }
  .row {
    display: flex;
    justify-content: space-between;
    gap: 18px;
    align-items: baseline;
    padding: 15px 2px;
    border-bottom: 1px solid var(--line);
  }
  .row b {
    font-family: var(--serif);
    font-weight: 500;
    font-size: 1.14rem;
    letter-spacing: 0.004em;
  }
  .row a.name {
    color: inherit;
    text-decoration: none;
    background: linear-gradient(var(--accent), var(--accent)) no-repeat 0 100% / 0 1px;
    transition: background-size 0.3s;
  }
  .row:hover a.name {
    background-size: 100% 1px;
  }
  .row .sub {
    color: var(--muted);
    font-size: 0.84rem;
    margin-top: 1px;
  }
  .row .aside {
    text-align: right;
    flex-shrink: 0;
  }
  .row .facts {
    color: var(--accent);
    font-size: 0.82rem;
  }

  .sheet {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 36px 38px 32px;
    box-shadow:
      0 1px 2px rgba(37, 42, 38, 0.03),
      0 10px 34px rgba(37, 42, 38, 0.045);
  }
  .sheet .denom {
    font-size: 0.68rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .sheet h2 {
    font-family: var(--serif);
    font-weight: 400;
    font-size: 2rem;
    margin-top: 7px;
    line-height: 1.15;
    letter-spacing: 0.002em;
    text-wrap: balance;
  }
  .sheet .addr {
    color: var(--muted);
    font-size: 0.88rem;
    margin-top: 5px;
  }
  .sheet .addr a {
    text-decoration: none;
    border-bottom: 1px solid var(--line);
  }

  dl.facts {
    margin-top: 24px;
    border-top: 1px solid var(--line);
  }
  dl.facts > div {
    display: grid;
    grid-template-columns: 132px 1fr;
    gap: 2px 24px;
    padding: 12px 0;
    border-bottom: 1px solid var(--line);
  }
  dt {
    color: var(--muted);
    font-size: 0.76rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding-top: 3px;
  }
  dd {
    font-size: 0.95rem;
  }
  .src {
    font-size: 0.72rem;
    color: var(--muted);
    white-space: nowrap;
    margin-left: 8px;
  }
  .src::before {
    content: '— ';
  }
  .src a {
    color: inherit;
  }

  .porownaj-z {
    margin-top: 26px;
    font-size: 0.88rem;
  }
  .porownaj-z .label {
    font-size: 0.68rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
    font-weight: 600;
  }
  .porownaj-z a {
    display: inline-block;
    margin: 10px 10px 0 0;
    border: 1px solid var(--accent);
    color: var(--accent);
    border-radius: 999px;
    padding: 7px 20px;
    text-decoration: none;
    transition:
      background 0.2s,
      color 0.2s;
  }
  .porownaj-z a:hover,
  .porownaj-z a:focus-visible {
    background: var(--accent);
    color: #fff;
  }

  .compare-scroll {
    overflow-x: auto;
  }
  table.compare {
    width: 100%;
    border-collapse: collapse;
    min-width: 520px;
    font-variant-numeric: tabular-nums;
  }
  .compare th,
  .compare td {
    padding: 11px 14px;
    text-align: left;
    vertical-align: top;
    border-bottom: 1px solid var(--line);
  }
  .compare thead th {
    font-family: var(--serif);
    font-weight: 500;
    font-size: 1.12rem;
    border-bottom: 1.5px solid var(--ink);
    padding-bottom: 9px;
  }
  .compare thead th:first-child {
    width: 160px;
  }
  .compare thead a {
    color: inherit;
    text-decoration: none;
    border-bottom: 1px solid var(--line);
  }
  .compare thead a:hover,
  .compare thead a:focus-visible {
    border-color: var(--accent);
  }
  .compare thead .sub {
    display: block;
    font-family: var(--sans);
    font-weight: 400;
    color: var(--muted);
    font-size: 0.78rem;
    margin-top: 2px;
  }
  .compare tbody th {
    color: var(--muted);
    font-weight: 500;
    font-size: 0.74rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    width: 160px;
  }
  .compare td {
    font-size: 0.92rem;
  }
  .compare td .src {
    display: block;
    margin: 2px 0 0;
    white-space: normal;
  }
  .compare td.brak {
    color: var(--muted);
  }
  .compare tbody tr:last-child td,
  .compare tbody tr:last-child th {
    border-bottom: 0;
  }
  .permalink {
    margin-top: 15px;
    font-size: 0.8rem;
    color: var(--muted);
    text-align: center;
  }
  .permalink code {
    background: var(--accent-soft);
    color: var(--accent);
    border-radius: 6px;
    padding: 2px 10px;
    font-size: 0.78rem;
  }

  footer.site {
    margin-top: 76px;
    text-align: center;
    color: var(--muted);
    font-size: 0.78rem;
  }
  footer.site::before {
    content: '·';
    display: block;
    color: var(--accent);
    font-size: 1.1rem;
    margin-bottom: 8px;
  }
  footer.site .line {
    font-family: var(--serif);
    font-style: italic;
    font-size: 0.95rem;
    margin-bottom: 10px;
  }

  @media (max-width: 560px) {
    dl.facts > div {
      grid-template-columns: 1fr;
    }
    .sheet {
      padding: 28px 22px;
    }
    .row {
      flex-direction: column;
      gap: 4px;
    }
    .row .aside {
      text-align: left;
    }
    .src {
      white-space: normal;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    * {
      transition: none !important;
    }
  }
</style>
