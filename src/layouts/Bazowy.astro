---
interface Props {
  tytul: string;
  opis: string;
}

const { tytul, opis } = Astro.props;
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tytul}</title>
    <meta name="description" content={opis} />
    <meta property="og:title" content={tytul} />
    <meta property="og:description" content={opis} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pl_PL" />
    <meta property="og:site_name" content="Church" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <header class="site">
      <div class="wordmark"><a href="/">Church<i>.</i></a></div>
      <div class="note">fakty ze źródłem i datą odczytu</div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site">
      <div class="line">Fakty ze źródłem, każdy z datą odczytu.</div>
      Dostrzegasz błąd w danych? Popraw go w repozytorium — każda zmiana faktu ma autora i historię.
    </footer>
    <script>
      // Jednorazowe wyłonienia sekcji tylko przy działającym JS —
      // bez niego strona jest w pełni widoczna od razu.
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const elementy = document.querySelectorAll('.hero, .list .row, .kicker, .sheet');
        elementy.forEach((e) => e.classList.add('will'));
        if ('IntersectionObserver' in window) {
          const io = new IntersectionObserver(
            (wpisy) => {
              for (const w of wpisy) {
                if (w.isIntersecting) {
                  w.target.classList.add('in');
                  io.unobserve(w.target);
                }
              }
            },
            { threshold: 0.1, rootMargin: '0px 0px -5% 0px' },
          );
          elementy.forEach((e) => io.observe(e));
        } else {
          elementy.forEach((e) => e.classList.add('in'));
        }
      }
    </script>
  </body>
</html>

<style is:global>
  :root {
    --bg: #fbfaf6;
    --surface: #ffffff;
    --ink: #252a26;
    --muted: #6b7169;
    --accent: #3e6b5e;
    --accent-deep: #33584e;
    --accent-soft: #edf2ef;
    --line: #e8e6dc;
    --line-soft: rgba(122, 128, 120, 0.28);
    --serif: 'Iowan Old Style', 'Palatino Linotype', Palatino, Georgia, serif;
    --sans: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
  }
  * {
    box-sizing: border-box;
    margin: 0;
  }
  body {
    background: var(--bg);
    color: var(--ink);
    font-family: var(--sans);
    line-height: 1.65;
    padding: 0 22px 64px;
    font-size: 15.5px;
    -webkit-font-smoothing: antialiased;
  }
  ::selection {
    background: var(--accent-soft);
    color: var(--accent-deep);
  }
  a {
    color: var(--accent);
  }
  :focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
    border-radius: 2px;
  }
  .wrap {
    max-width: 660px;
    margin: 0 auto;
  }

  .will {
    opacity: 0;
    transform: translateY(12px);
    transition:
      opacity 0.8s ease,
      transform 0.8s cubic-bezier(0.2, 0.6, 0.2, 1);
  }
  .will.in {
    opacity: 1;
    transform: none;
  }
  .list .row.will:nth-child(2) {
    transition-delay: 0.07s;
  }
  .list .row.will:nth-child(3) {
    transition-delay: 0.14s;
  }

  .kicker {
    font-size: 0.68rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--muted);
    margin: 60px 0 16px;
    text-align: center;
  }
  .kicker::after {
    content: '';
    display: block;
    width: 1px;
    height: 30px;
    margin: 14px auto 0;
    background: linear-gradient(var(--line-soft), transparent);
  }

  header.site {
    padding: 66px 0 6px;
    text-align: center;
  }
  .wordmark {
    font-family: var(--serif);
    font-size: 1.5rem;
    letter-spacing: 0.015em;
  }
  .wordmark a {
    color: inherit;
    text-decoration: none;
  }
  .wordmark i {
    color: var(--accent);
    font-style: normal;
  }
  header.site .note {
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
    margin-top: 10px;
  }

  .hero {
    text-align: center;
    padding: 36px 0 6px;
    position: relative;
  }
  .hero::before {
    content: '';
    position: absolute;
    inset: -40px -60px auto;
    height: 300px;
    pointer-events: none;
    background: radial-gradient(340px 190px at 50% 30%, rgba(62, 107, 94, 0.055), transparent 70%);
  }
  .hero h1 {
    font-family: var(--serif);
    font-weight: 400;
    font-size: clamp(2.1rem, 5.6vw, 3rem);
    line-height: 1.18;
    text-wrap: balance;
    letter-spacing: 0.002em;
  }
  .hero .sub {
    font-family: var(--serif);
    font-style: italic;
    color: var(--muted);
    margin-top: 12px;
    font-size: 1.12rem;
    letter-spacing: 0.005em;
  }
  .miasta {
    margin-top: 28px;
  }
  .miasta a {
    display: inline-block;
    margin: 0 5px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--surface);
    padding: 9px 26px;
    font-size: 0.95rem;
    font-family: var(--serif);
    color: inherit;
    text-decoration: none;
    box-shadow:
      0 1px 2px rgba(37, 42, 38, 0.03),
      0 6px 24px rgba(37, 42, 38, 0.05);
    transition:
      border-color 0.2s,
      color 0.2s;
  }
  .miasta a:hover,
  .miasta a:focus-visible {
    border-color: var(--accent);
    color: var(--accent);
  }
  .miasto-tytul {
    font-family: var(--serif);
    font-weight: 400;
    font-size: 1.5rem;
    text-align: center;
    margin-top: 46px;
    letter-spacing: 0.01em;
  }
  .miasto-tytul::after {
    content: '';
    display: block;
    width: 1px;
    height: 22px;
    margin: 10px auto 0;
    background: linear-gradient(var(--line-soft), transparent);
  }

  .filtry {
    margin-top: 30px;
    text-align: left;
  }
  .filtry-grupa + .filtry-grupa {
    margin-top: 16px;
  }
  .chipsy {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 8px;
  }
  .chip {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 6px 13px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--surface);
    font-size: 0.85rem;
    cursor: pointer;
  }
  .chip:has(input:checked) {
    border-color: var(--accent);
    background: var(--accent-soft);
    color: var(--accent-deep);
  }
  .chip:focus-within {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .filtry-nota {
    color: var(--muted);
    font-size: 0.78rem;
    margin-top: 14px;
    max-width: 60ch;
  }
  .wkrotce {
    color: var(--accent-deep);
    font-size: 0.83rem;
    font-weight: 600;
  }
  .pusto {
    color: var(--muted);
    font-size: 0.86rem;
    padding: 18px 2px;
  }
  /* .row jest flexem, więc atrybut hidden wymaga jawnego zgaszenia. */
  .row[hidden],
  .filtry[hidden],
  .chipsy[hidden],
  .wkrotce[hidden],
  .pusto[hidden] {
    display: none;
  }

  .list {
    margin-top: 28px;
    border-top: 1px solid var(--line);
    text-align: left;
  }
  .row {
    display: flex;
    justify-content: space-between;
    gap: 18px;
    align-items: baseline;
    padding: 15px 2px;
    border-bottom: 1px solid var(--line);
  }
  .row b {
    font-family: var(--serif);
    font-weight: 500;
    font-size: 1.14rem;
    letter-spacing: 0.004em;
  }
  .row a.name {
    color: inherit;
    text-decoration: none;
    background: linear-gradient(var(--accent), var(--accent)) no-repeat 0 100% / 0 1px;
    transition: background-size 0.3s;
  }
  .row:hover a.name {
    background-size: 100% 1px;
  }
  /* Bez tego blok nazwy kurczy się do treści, a „space-between" stawia
     go w innym miejscu w każdym wierszu — nazwy parafii się rozjeżdżają. */
  .row .who {
    flex: 1;
    min-width: 0;
  }
  .row .sub {
    color: var(--muted);
    font-size: 0.84rem;
    margin-top: 1px;
  }
  .row .aside {
    text-align: right;
    flex-shrink: 0;
  }
  .row .facts {
    color: var(--accent);
    font-size: 0.82rem;
  }

  .wizytowka {
    margin: -36px -38px 22px;
    border-radius: 10px 10px 0 0;
    overflow: hidden;
  }
  .wizytowka img {
    display: block;
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
  }
  .wizytowka figcaption {
    font-size: 0.68rem;
    color: var(--muted);
    padding: 8px 38px 0;
    letter-spacing: 0.02em;
  }
  .wizytowka figcaption a {
    color: inherit;
  }
  .row img.mini {
    width: 56px;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    border-radius: 5px;
    flex-shrink: 0;
    align-self: center;
  }
  .sheet {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 36px 38px 32px;
    box-shadow:
      0 1px 2px rgba(37, 42, 38, 0.03),
      0 10px 34px rgba(37, 42, 38, 0.045);
  }
  .sheet .denom {
    font-size: 0.68rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .sheet h2 {
    font-family: var(--serif);
    font-weight: 400;
    font-size: 2rem;
    margin-top: 7px;
    line-height: 1.15;
    letter-spacing: 0.002em;
    text-wrap: balance;
  }
  .sheet .addr {
    color: var(--muted);
    font-size: 0.88rem;
    margin-top: 5px;
  }
  .sheet .addr a {
    text-decoration: none;
    border-bottom: 1px solid var(--line);
  }

  dl.facts {
    margin-top: 24px;
    border-top: 1px solid var(--line);
  }
  dl.facts > div {
    display: grid;
    grid-template-columns: 132px 1fr;
    gap: 2px 24px;
    padding: 12px 0;
    border-bottom: 1px solid var(--line);
  }
  dt {
    color: var(--muted);
    font-size: 0.76rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding-top: 3px;
  }
  dd {
    font-size: 0.95rem;
  }
  .src {
    font-size: 0.72rem;
    color: var(--muted);
    white-space: nowrap;
    margin-left: 8px;
  }
  .src::before {
    content: '— ';
  }
  .src a {
    color: inherit;
  }

  .zglos {
    margin-top: 12px;
    font-size: 0.78rem;
    color: var(--muted);
  }
  .porownaj-z {
    margin-top: 26px;
    font-size: 0.88rem;
  }
  .porownaj-z .label {
    font-size: 0.68rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
    font-weight: 600;
  }
  .porownaj-z a {
    display: inline-block;
    margin: 10px 10px 0 0;
    border: 1px solid var(--accent);
    color: var(--accent);
    border-radius: 999px;
    padding: 7px 20px;
    text-decoration: none;
    transition:
      background 0.2s,
      color 0.2s;
  }
  .porownaj-z a:hover,
  .porownaj-z a:focus-visible {
    background: var(--accent);
    color: #fff;
  }

  .dots {
    display: inline-flex;
    gap: 3.5px;
    vertical-align: -1px;
  }
  .dots u {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
  }
  .dots u.o {
    background: transparent;
    box-shadow: inset 0 0 0 1px var(--line-soft);
  }
  .dots u.p {
    background: linear-gradient(90deg, var(--accent) var(--f, 50%), transparent var(--f, 50%));
    box-shadow: inset 0 0 0 1px var(--line-soft);
  }
  .score-num {
    font-family: var(--serif);
    font-size: 1.05em;
    font-variant-numeric: tabular-nums;
  }

  .profile-top {
    display: flex;
    justify-content: space-between;
    gap: 24px;
    align-items: flex-start;
  }
  .bigscore {
    text-align: right;
    flex-shrink: 0;
    padding-top: 4px;
  }
  .bigscore .n {
    font-family: var(--serif);
    font-size: 2.3rem;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  .bigscore .n small {
    font-size: 1.05rem;
    color: var(--muted);
  }
  .bigscore .dots {
    margin-top: 6px;
  }
  .bigscore .c {
    font-size: 0.74rem;
    color: var(--muted);
    margin-top: 5px;
  }

  .gallery {
    display: flex;
    gap: 8px;
    margin-top: 22px;
  }
  .gallery .ph {
    flex: 1;
    max-width: 33%;
    aspect-ratio: 4 / 3;
    border-radius: 7px;
    position: relative;
    overflow: hidden;
    margin: 0;
    background: var(--accent-soft);
  }
  .gallery .ph img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .gallery .ph figcaption {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    font-size: 0.62rem;
    color: #fff;
    background: linear-gradient(transparent, rgba(37, 42, 38, 0.55));
    padding: 16px 8px 5px;
    letter-spacing: 0.02em;
  }

  .aspects {
    margin-top: 24px;
    border-top: 1px solid var(--line);
    padding-top: 18px;
  }
  .aspects h4 {
    font-size: 0.68rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
    font-weight: 600;
  }
  .agrid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 9px 36px;
    margin-top: 12px;
  }
  .arow {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.88rem;
  }
  .arow .v {
    display: flex;
    align-items: center;
    gap: 9px;
  }
  .arow .score-num {
    font-size: 0.92rem;
  }

  .voices {
    margin-top: 30px;
    border-top: 1px solid var(--line);
    padding-top: 20px;
  }
  .voices h3 {
    font-family: var(--serif);
    font-weight: 400;
    font-size: 1.3rem;
    display: flex;
    align-items: baseline;
    gap: 10px;
  }
  .voices h3 small {
    font-family: var(--sans);
    font-size: 0.76rem;
    color: var(--muted);
  }
  .quote {
    padding: 19px 0 8px;
    border-bottom: 1px solid var(--line);
  }
  .quote:last-of-type {
    border-bottom: 0;
  }
  .qhead {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
    margin-bottom: 9px;
  }
  .qhead .by {
    font-size: 0.8rem;
    color: var(--muted);
  }
  .qhead .by b {
    color: var(--ink);
    font-weight: 600;
  }
  .qhead .sc {
    font-size: 0.82rem;
    color: var(--muted);
    display: flex;
    gap: 8px;
    align-items: center;
    flex-shrink: 0;
  }
  .quote p {
    font-family: var(--serif);
    font-size: 1.16rem;
    line-height: 1.55;
    font-style: italic;
    font-feature-settings: 'onum';
    text-indent: -0.42em;
    max-width: 56ch;
  }
  .quote p::before {
    content: '„';
  }
  .quote p::after {
    content: '”';
  }
  .voices .pusto {
    font-family: var(--serif);
    font-style: italic;
    color: var(--muted);
    padding: 14px 0 4px;
  }
  .voices .mod {
    font-size: 0.72rem;
    color: var(--muted);
    margin-top: 16px;
    max-width: 52ch;
  }
  .mod::before {
    content: '';
    display: inline-block;
    width: 5px;
    height: 5px;
    border-radius: 99px;
    background: var(--accent);
    margin-right: 7px;
    vertical-align: 2px;
  }
  .addvoice {
    margin-top: 18px;
    display: inline-block;
    border: 1px solid var(--accent);
    color: var(--accent);
    border-radius: 999px;
    padding: 8px 24px;
    font-size: 0.88rem;
    text-decoration: none;
    transition:
      background 0.2s,
      color 0.2s;
  }
  .addvoice:hover,
  .addvoice:focus-visible {
    background: var(--accent);
    color: #fff;
  }

  .rank ol.rank-lista {
    list-style: none;
    border-top: 1px solid var(--line);
    padding: 0;
  }
  .rank li {
    display: flex;
    align-items: baseline;
    gap: 18px;
    padding: 14px 2px;
    border-bottom: 1px solid var(--line);
  }
  .rank .poz {
    font-family: var(--serif);
    font-style: italic;
    font-size: 1.1rem;
    color: var(--muted);
    width: 1.1em;
    text-align: right;
    flex-shrink: 0;
  }
  .rank .who {
    flex: 1;
  }
  .rank .who b {
    font-family: var(--serif);
    font-weight: 500;
    font-size: 1.12rem;
  }
  .rank .who a.name {
    color: inherit;
    text-decoration: none;
  }
  .rank .who .sub {
    color: var(--muted);
    font-size: 0.82rem;
  }
  .rank .sc {
    display: flex;
    gap: 10px;
    align-items: baseline;
    flex-shrink: 0;
  }
  .rank .sc .score-num {
    font-size: 1.05rem;
  }
  .rank .sc small {
    color: var(--muted);
    font-size: 0.74rem;
  }
  .rank .foot {
    font-size: 0.76rem;
    color: var(--muted);
    margin-top: 14px;
    max-width: 54ch;
    line-height: 1.6;
  }

  .wstep {
    margin-top: 14px;
    font-size: 0.95rem;
    max-width: 56ch;
  }
  .form-glos {
    margin-top: 20px;
    border-top: 1px solid var(--line);
    padding-top: 18px;
  }
  .form-glos label {
    display: block;
    margin-top: 12px;
    font-size: 0.8rem;
    color: var(--muted);
  }
  .form-glos input {
    display: block;
    width: 100%;
    margin-top: 5px;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--surface);
    padding: 9px 13px;
    font: inherit;
    color: var(--ink);
  }
  .form-glos input:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 1px;
  }
  .form-glos textarea {
    width: 100%;
    margin-top: 5px;
    padding: 9px 11px;
    border: 1px solid var(--line);
    border-radius: 7px;
    background: var(--bg);
    font: inherit;
    color: inherit;
    resize: vertical;
  }
  .form-glos .oceny {
    border: 1px solid var(--line);
    border-radius: 9px;
    padding: 12px 14px 14px;
    margin-top: 4px;
  }
  .form-glos .oceny legend {
    font-family: var(--serif);
    font-size: 1.02rem;
    padding: 0 6px;
  }
  .ocena {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
    padding: 5px 0;
  }
  .ocena-nazwa {
    font-size: 0.9rem;
  }
  .ocena-skala {
    display: inline-flex;
    gap: 5px;
  }
  .gwiazdka {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 36px;
    min-height: 36px;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--surface);
    font-size: 0.86rem;
    cursor: pointer;
  }
  /* Natywny przycisk zostaje w drzewie dostępności, ale wizualnie
     zastępuje go całe pole — cel dotykowy 36 px zamiast kropki. */
  .gwiazdka input {
    position: absolute;
    opacity: 0;
    width: 1px;
    height: 1px;
  }
  .gwiazdka:has(input:checked) {
    border-color: var(--accent);
    background: var(--accent-soft);
    color: var(--accent-deep);
    font-weight: 600;
  }
  .gwiazdka:focus-within {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .form-glos button {
    margin-top: 16px;
    border: 0;
    background: var(--accent);
    color: #fff;
    font: inherit;
    font-size: 0.9rem;
    padding: 9px 24px;
    border-radius: 999px;
    cursor: pointer;
    transition: background 0.2s;
